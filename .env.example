# ============================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env for local development
# In Railway, set these in the Variables tab
# ============================================

# Database Configuration
# -----------------------
# Railway auto-configures this when you add PostgreSQL service
# For local dev, use your local PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/telesum

# Railway also provides these automatically with PostgreSQL:
# PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE

# Telegram API Configuration  
# --------------------------
# Get these from https://my.telegram.org
# Required for import features
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890
TELEGRAM_CHANNEL_USERNAME=channel_username

# Grok AI Configuration
# ---------------------
# Get API key from https://x.ai
# Required for AI summary features  
GROK_API_KEY=your_grok_api_key
GROK_API_URL=https://api.x.ai/v1

# Application Settings
# --------------------
APP_ENV=development                          # production on Railway
SECRET_KEY=your-secret-key-change-in-production
PORT=8000                                    # Railway provides this as 8080

# Feature Configuration
# ---------------------
SYNC_INTERVAL_HOURS=6                        # Hours between auto-sync
MAX_GROK_REQUESTS_PER_HOUR=100              # API rate limiting

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. Railway automatically sets PORT
# 2. Add PostgreSQL service for auto DATABASE_URL
# 3. App works without all variables (graceful degradation)
# 4. Check /api/config/status after deployment
# ============================================