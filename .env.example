# ============================================
# TELE-SUM ENVIRONMENT VARIABLES
# Railway Production Deployment Configuration
# ============================================
# 🚀 DEPLOYED ON RAILWAY - https://railway.app
#
# VISION: Transform Telegram's append-only message stream 
# into searchable, AI-enriched knowledge base
# 
# Copy this file to .env for local development
# In Railway, set these in the Variables tab
# ============================================

# ============================================
# DATABASE CONFIGURATION
# Core storage for messages, summaries & categories
# ============================================
# Railway auto-provisions PostgreSQL with this URL
# For local development, use your local PostgreSQL instance
DATABASE_URL=postgresql://user:password@localhost:5432/telesum

# Railway also provides these automatically with PostgreSQL:
# PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE

# ============================================
# TELEGRAM API CONFIGURATION
# Enables extraction of 100% channel history
# ============================================
# VISION REQUIREMENT: Complete history import & ongoing sync
# Get these credentials from https://my.telegram.org
#
# Without these, the system cannot import messages but can still:
# - Manually add content
# - Search existing data  
# - Export data
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890                  # Include country code
TELEGRAM_CHANNEL_USERNAME=channel_username  # Without @ symbol

# ============================================
# GROK AI CONFIGURATION
# Critical for X/Twitter content analysis
# ============================================
# VISION REQUIREMENT: Grok's unique X/Twitter access
# Grok is the ONLY AI that can directly read X/Twitter posts
# Get API key from https://x.ai
#
# Without this, the system still functions with graceful degradation:
# - Messages are stored and searchable
# - Manual categorization available
# - Export functionality works
# - Failed messages can be retried when Grok is available
GROK_API_KEY=your_grok_api_key
GROK_API_URL=https://api.x.ai/v1           # Default Grok endpoint

# ============================================
# APPLICATION SETTINGS
# Core application configuration
# ============================================
# Environment mode - Railway sets this to 'production' automatically
APP_ENV=development                          

# Security key for session management
# Railway can auto-generate this, or provide your own secure string
SECRET_KEY=your-secret-key-change-in-production

# Server port - Railway provides PORT=8080 automatically  
# Only set this for local development
PORT=8000                                    

# ============================================
# FEATURE CONFIGURATION
# Tune system behavior and limits
# ============================================
# VISION: Maintain sync within 12 hours (we do better with 6)
# How often to check for new Telegram messages
SYNC_INTERVAL_HOURS=6                        

# VISION: Cost controls for Grok API usage
# Prevent runaway API costs with rate limiting
MAX_GROK_REQUESTS_PER_HOUR=100              

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. Railway automatically sets PORT
# 2. Add PostgreSQL service for auto DATABASE_URL
# 3. App works without all variables (graceful degradation)
# 4. Check /api/config/status after deployment
# ============================================