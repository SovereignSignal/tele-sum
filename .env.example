# ============================================
# TELE-SUM ENVIRONMENT
# Copy to .env for local dev. In Railway, set these on the service.
# ============================================

# --- Database (required) ----------------------
# Either set DATABASE_URL or rely on Railway's auto-injected PG* vars.
DATABASE_URL=postgresql://user:password@localhost:5432/telesum

# --- Telegram (required, bot mode only) -------
# Comma-separated bot tokens from BotFather. The bot must be admin in
# any channel you want it to read.
TELEGRAM_BOT_TOKENS=
ENABLE_BOT_MODE=true
BOT_POLLING_INTERVAL=2

# --- AI provider (required) -------------------
# Pick a provider; key/base_url/model can be supplied here, or read
# from the api_providers DB table when those env vars are blank.
# Supported providers:
#   - ollama     (Ollama Cloud, native /api/chat — base_url ends in /api)
#   - anthropic  (native /v1/messages)
#   - any OpenAI-compatible provider (grok, openai, openrouter, perplexity, ...)
AI_PROVIDER=ollama
AI_MODEL=glm-5.1
AI_API_KEY=
AI_BASE_URL=https://ollama.com/api

# --- App security -----------------------------
# API_KEY protects /api/* and the web UI. SECRET_KEY signs session cookies.
# Both auto-generate random values if unset, but you'll lose sessions on restart.
API_KEY=
SECRET_KEY=
APP_ENV=development
PORT=8000

# --- Tuning -----------------------------------
SYNC_INTERVAL_HOURS=6
MAX_AI_REQUESTS_PER_HOUR=100
MAX_PROCESSING_RETRIES=3
PROCESSING_BATCH_SIZE=10
RUN_SYNC_ON_STARTUP=true
# Set false to keep processing in PostgreSQL without Notion writes.
ENABLE_NOTION_SYNC=true
